PGPOOL_USERPASS="pgpool"
PGPOOL_PATH="/usr/bin"
PGPOOL_PROCESS="pgpool"
PGPOOL_PID_DIR="/var/pgpool/pid"
PGPOOL_LOCKFILE_DIR="/var/lock/subsys"
PGPOOL_CONF="/opt/Postgresql/config/pgpool/pgpool.conf"
PGPOOL_PCPCONF="/opt/Postgresql/config/pgpool/pcp.conf"
PGPOOL_HBACONF="/opt/Postgresql/config/pgpool/pool_hba.conf"
PGPOOL_LOG="/var/log/pgpool/pgpool.log"
PGPOOL_SOCKET_DIR="/tmp/.s"
PGPOOL_EXTENSION_DIR="/opt/Postgresql/config/pgpool_ext"
PGPOOL_OPTS=" -n -D"
PGPOOL_DAEMON="/usr/bin/pgpool"
