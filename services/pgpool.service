#pgpool.service
[Unit]
Description=Pgpool-II
After=syslog.target network.target postgresql.service
#Upholds=postgresql.service
#Requires=postgresql.service #Is not active for prevent that pgpools dead when postgresql fails test by script
#BindsTo=postgresql.service
#Start five upon 50 sec
StartLimitIntervalSec=50
StartLimitBurst=5

[Service]
Type=simple

User=postgres
Group=postgres

EnvironmentFile=-/etc/sysconfig/pgpool
EnvironmentFile=/opt/Postgresql/config/scripts/pgpool.vars

Restart=on-failure
RestartSec=5s

#ExecCondition=/bin/bash -xc '/usr/bin/systemctl is-active --quiet postgresql.service && { [[ %i == "main" ]] && exit 255 || exit 1; } || exit 0'
ExecStartPre=/opt/Postgresql/config/scripts/service/pgpool_start
ExecStart=/usr/bin/pgpool -D -a $PGPOOL_HBACONF -f $PGPOOL_CONF -F $PGPOOL_PCPCONF $PGPOOL_OPTS
ExecReload=/usr/bin/pgpool -D -a ${PGPOOL_HBACONF} -f ${PGPOOL_CONF} -F ${PGPOOL_PCPCONF} reload
ExecStop=/usr/bin/pgpool -D -f ${PGPOOL_CONF} -m fast stop
ExecStartPost=/opt/Postgresql/config/scripts/service/pgpool_start_post

#ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
